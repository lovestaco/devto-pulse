# dev.to API key: https://dev.to/settings/extensions
DEVTO_API_KEY=your_dev_to_api_key_here

# Postgres connection string (Seenode provides this for a managed database)
DATABASE_URL=postgres://pulse:pulse@localhost:55434/pulse

# Set to "true" when the database requires TLS (most managed Postgres does)
PGSSL=false

PORT=3000

# Minutes between dev.to syncs for the worker / in-process sync
SYNC_INTERVAL_MINUTES=180

# Run the sync loop inside the web process (useful if you only deploy one service)
INPROCESS_SYNC=false

# Optional: protect the dashboard with HTTP basic auth (page views are private stats)
DASHBOARD_USER=
DASHBOARD_PASSWORD=
